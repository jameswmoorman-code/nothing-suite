# ---- Your keys. Never committed. ----
PORT=8080

# Public HTTPS origin Twilio can reach (ngrok / Cloudflare Tunnel). No trailing slash.
PUBLIC_URL=https://example.ngrok-free.app

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to "false" ONLY for local testing without a public URL
TWILIO_VALIDATE_SIGNATURE=true

# ---- Speech-to-text ----
# "local"  = free, runs on this machine with faster-whisper (pip install -r requirements.txt)
# "openai" = paid per audio minute, fastest word-by-word text; needs OPENAI_API_KEY
TRANSCRIBER=local

# local only. tiny.en (fast, rough) | base.en (good default) | small.en (better, needs a decent CPU)
LOCAL_WHISPER_MODEL=base.en
PYTHON_BIN=python3

# openai only (platform.openai.com)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Shared secret the Android app sends as ?token= when connecting to /app
APP_SHARED_SECRET=change-me-to-a-long-random-string

# What the caller hears before transcription begins
GREETING_TEXT=Hi, this call is being screened. Please say who you are and why you are calling.
