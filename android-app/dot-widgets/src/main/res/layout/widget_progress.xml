<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/day_label" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAY 62%" />
    <TextView android:id="@+id/day_dots" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.3" android:textColor="@color/dw_white" android:text="●●●●●●●●●●●●○○○○○○○○" />

    <TextView android:id="@+id/month_label" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="MONTH 50%" />
    <TextView android:id="@+id/month_dots" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.3" android:textColor="@color/dw_white" android:text="●●●●●●●●●●○○○○○○○○○○" />

    <TextView android:id="@+id/year_label" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="YEAR 71%" />
    <TextView android:id="@+id/year_dots" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.3" android:textColor="@color/dw_red" android:text="●●●●●●●●●●●●●●○○○○○○" />

    <TextView android:id="@+id/locked" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/locked" android:textColor="@color/dw_red" android:visibility="gone" />
</LinearLayout>
