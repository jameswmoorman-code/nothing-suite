<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/label" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOLIDAY" />
    <TextView android:id="@+id/days" style="@style/DotText.Hero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="23" />
    <TextView android:id="@+id/unit" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAYS" android:textColor="@color/dw_red" />
    <TextView android:id="@+id/locked" style="@style/DotText.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/locked" android:textColor="@color/dw_red" android:visibility="gone" />
</LinearLayout>
