<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.nothing.thirdparty" />

    <!-- ===================== Telephony (default dialer) ===================== -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets the live screen pop up while the phone is unlocked and in use (Android only
         honours full-screen intents on the lock screen). Granted by the user in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===================== Live transcript + background =================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keep the concierge link alive while the phone sleeps (standard for call apps). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ===================== Glyph Developer Kit ============================ -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />


    <!-- Only a dialer needs these; declared so the role is offered -->
    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <!-- Needed so the app can offer itself as a dialer target for other apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".NothingSuiteApp"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_call"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- "test" for development; production key from Nothing's developer programme -->
        <meta-data android:name="NothingKey" android:value="test" />

        <!-- ================== Launcher / setup ================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".inbox.InboxActivity"
            android:exported="false" />

        <activity
            android:name=".hold.HoldForMeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Glyph Toy: pick "Concierge" with the Glyph button and the matrix shows caller ID
             + live transcript during screened calls, locked or not. -->
        <service android:name=".glyph.ConciergeToy" android:exported="true">
            <intent-filter><action android:name="com.nothing.glyph.TOY" /></intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/toy_concierge" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/toy_concierge" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_concierge_summary" />
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <!-- keep drawing with the screen off (always-on); the phone sends EVENT_AOD each minute -->
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>

        <!--
          ================== Dialer intent filters ==================
          RoleManager will only offer ROLE_DIALER if the app handles:
            * ACTION_DIAL with no data, and with tel: data
            * ACTION_VIEW tel:
            * ACTION_CALL_BUTTON (optional but conventional)
          For this MVP MainActivity is also the dial screen.
        -->
        <activity-alias
            android:name=".DialActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- ================== Incoming call UI ================== -->
        <activity
            android:name=".telecom.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="uk.nothingsuite.app.call" />

        <!-- ================== Live transcript ================== -->
        <activity
            android:name=".transcript.LiveTranscriptActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!--
          ================== InCallService ==================
          BIND_INCALL_SERVICE is a signature|privileged permission that the
          *system* holds; declaring it here means only the system can bind us.
          IN_CALL_SERVICE_UI = true tells Telecom we draw our own call screen.
        -->
        <!-- Keeps the concierge link open in the background so calls pop the live screen. -->
        <service
            android:name=".transcript.ConciergeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the user's own call-screening server so a screened call can be shown live" />
        </service>

        <service
            android:name=".telecom.ScreenerInCallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!--
          ================== Glyph Progress Tracker ==================
          NotificationListenerService: user must enable it in
          Settings → Notifications → Device & app notifications.
        -->
        <service
            android:name=".glyph.GlyphProgressListener"
            android:exported="true"
            android:label="@string/glyph_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="ongoing|alerting|silent" />
        </service>
    </application>
</manifest>
